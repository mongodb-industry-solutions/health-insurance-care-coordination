MONGODB_URI=
EXAMPLE_ACCESS_KEY=
EXAMPLE_SECRET_KEY=
ORIGINS=http://localhost:3000

# dry_run (default) records what it would have sent instead of calling an agent.
# Set to "http" (or anything else) once a real target is configured below.
AGENT_INVOKE_MODE=http
LOCAL_AGENTIC_DEPLOYMENT=true

# --- local mode only (LOCAL_AGENTIC_DEPLOYMENT=true) ---
INSURANCE_AGENT_URL=http://localhost:3001
CARE_AGENT_URL=http://localhost:3002

