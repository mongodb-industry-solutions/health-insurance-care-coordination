# Copy this file to .env before running `agentengine dev up`.
#
# Set LLM_API_KEY for the client configured in the agent source.
# Change the model in the LLM builder.

MONGODB_URI=

# Insurance database: members, policies, plans, claims, the shared authorization trace
# (`audit_log`) and this agent's reasoning text (`admin_reasoning`). Always read from here,
# never hard-coded. This agent works in this one database and has no clinical access.
MONGODB_DATABASE=

# Credential for the LLM client in the agent source.

# Required when features.memory is true in agent.yaml.
VOYAGE_API_KEY=
LLM_API_KEY=
