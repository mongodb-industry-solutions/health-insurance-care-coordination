# Copy this file to .env before running `agentengine dev up`.
#
# Set LLM_API_KEY for the client configured in the agent source.
# Change the model in the LLM builder.

MONGODB_URI=

# Clinical database: member clinical profiles, pharmacy fills, guidelines and this
# agent's reasoning text. Always read from here, never hard-coded.
MONGODB_DATABASE=

# Insurance database. The agent reads and writes ONE collection in it, the shared
# authorization trace (`audit_log`), and nothing else.
AUDIT_DATABASE=

# Credential for the LLM client in the agent source.

# Required when features.memory is true in agent.yaml.
VOYAGE_API_KEY=
LLM_API_KEY=
