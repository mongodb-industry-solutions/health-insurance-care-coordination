# Copy this file to .env before running `agentic dev up`.
#
# Set exactly one provider key for normal local development. Grove Foundry uses
# OPENAI_API_KEY or ANTHROPIC_API_KEY with the matching provider-specific base URL.
# Optional model overrides can live in agent.yaml under config.model.

MONGODB_URI=

# Application database holding members, claims, guidelines and the audit log.
# Distinct from the platform's own store DB (mdb_store), which the SDK scopes
# itself. Required once the tools read Mongo directly instead of the backend.
DATABASE_NAME=health_insurance_agent

# Gemini
GEMINI_API_KEY=

# OpenAI, OpenAI-compatible Grove Foundry, or Azure OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_VERSION=

# Anthropic or Anthropic-compatible Grove Foundry
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Cerebras
CEREBRAS_API_KEY=

# Required when features.memory is true in agent.yaml.
VOYAGE_API_KEY=
